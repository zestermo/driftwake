{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/dev/*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/dev/*)",
      "PowerShell(.\\tools\\dev\\*)",
      "PowerShell(& .\\tools\\dev\\*)",
      "PowerShell(& $env:GODOT *)",
      "Bash(\"$GODOT\" *)",
      "Bash($GODOT *)",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(gh run *)",
      "Bash(gh release view *)",
      "Bash(gh release list*)",
      "Bash(py tools/texture_gen/*)",
      "PowerShell(py tools/texture_gen/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "PowerShell(Select-String *)",
      "Bash",
      "PowerShell",
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin v*)",
      "Bash(git tag*)",
      "Bash(git -C * tag*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push origin v*)",
      "PowerShell(git tag*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/dev/crew.ps1\" -Hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/dev/hooks/guard.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/dev/hooks/gdcheck.ps1\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/dev/hooks/crewcheck.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/dev/hooks/finish.ps1\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/tools/dev/hooks/finish.ps1\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
