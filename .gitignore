# Godot 4+ specific ignores
.godot/
/android/
__pycache__/

# dev tool output (screenshots, test logs)
/tools/dev/out/*
!/tools/dev/out/.gdignore

# exported builds, wherever they're saved (GitHub refuses files over 100 MB)
*.exe
*.pck

# the web export, and its copy in the site (tools/dev/build_web.ps1)
/web/build/
/web/site/play/

# Claude Code worktrees (one per parallel session)
/.claude/worktrees/
