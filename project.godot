[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="PlayerBody"
3d_physics/layer_3="EnemyBody"
3d_physics/layer_4="PlayerHitbox"
3d_physics/layer_5="EnemyHurtbox"
3d_physics/layer_6="EnemyHitbox"
3d_physics/layer_7="PlayerHurtbox"
3d_physics/layer_8="Water"
3d_physics/layer_9="InteractionZone"
3d_physics/layer_10="LootDrop"
3d_physics/layer_11="Ragdoll"
3d_physics/layer_12="EnemySolid"

[navigation]

3d/merge_rasterizer_cell_scale=0.1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.86, 1)

[shader_globals]

psx_snap_res={
"type": "vec2",
"value": Vector2(320, 180)
}
psx_affine={
"type": "float",
"value": 0.6
}
cloud_shadow={
"type": "vec4",
"value": Vector4(0.3, 0, 0, 0)
}
sky_haze={
"type": "vec4",
"value": Vector4(0.5, 0.72, 0.92, 0)
}
fog_range={
"type": "vec2",
"value": Vector2(90, 750)
}
