; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DriftWake"
config/version="1.5"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/game/settings.gd"
FX="*res://scripts/game/fx.gd"
CombatManager="*res://scripts/combat/combat_manager.gd"
Ocean="*res://scripts/ocean/ocean_manager.gd"
GameManager="*res://scripts/game/game_manager.gd"
PSX="*res://scripts/psx/psx_settings.gd"
Dialogue="*res://scripts/dialogue/dialogue_manager.gd"
GameMenu="*res://scripts/ui/game_menu.gd"
Net="*res://scripts/net/network_manager.gd"
Music="*res://scripts/game/music.gd"
Weather="*res://scripts/world/weather.gd"
DevCapture="*res://scripts/game/dev_capture.gd"
Perf="*res://scripts/game/perf_monitor.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/custom_font="res://assets/fonts/PixelifySans-Regular.woff2"

