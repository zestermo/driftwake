			"title": "{Verb} {name}",
			"ask": "You look like you can handle yourself.",
			"plea": ["{name}. It's been bad since it started, and it's getting worse.", "{verb} it, and the town will remember you. I'll remember you with gold."],
			"remind_choice": "Where was it again?",
			"remind": "{name}. You can't miss it. It won't miss you either.",
			"found": "Done with {name}. Tell {who}.",
			"done": "It's done: {name}.",
			"thanks": ["Truly? Then we can sleep again. Some of us, anyway.", "Here. You've earned every coin of it."],
		},
	},
	"scout_at": {
		"camp": {"look": "Count the bandits at their camp for me. From a distance, mind. Counting's no good if you're dead", "seen": "A camp of cutthroats round a fire, a watchtower, a chief in a long coat. Tell {who}.", "title": "Scout the bandit camp"},
		"beast": {"look": "Go and look at the beast's ground. Not at the beast. The ground. I need to know if it's moved", "seen": "Churned sand, bones, and tracks that go nowhere. It hasn't moved. Tell {who}.", "title": "Scout the beast's ground"},
		"lookout": {"look": "Climb to the lookout and tell me if the sea's clear to the next isle", "seen": "The whole island below, gold to the haze, and the sea clear to the horizon. Tell {who}.", "title": "The view from the lookout"},
		"lair": {"look": "Something's changed at the burrows inland. Go and see, from the edge", "seen": "The burrows are clicking, and there are more of them than anyone said. Tell {who}.", "title": "Scout the burrows"},
		"ruins": {"look": "There's a carving on the old stones the wind uncovers every few years. Go and read it for me", "seen": "A carving of a city swallowed by a wave of sand. Tell {who}.", "title": "Read the old stones"},
		"any": {"look": "Go and have a look at {name} for me. I keep hearing things, and none of them good", "seen": "You've seen {name} for yourself. Tell {who}.", "title": "A look at {name}"},
	},
	"lost_at": {"ruins": "in the old stones", "lookout": "up at the lookout", "camp": "near the bandits' camp", "lair": "at the edge of the burrows",
		"beast": "on the far side, where the beast sleeps", "any": "out by {name}"},
	"elder_about": ["The desert gives us dates, salt and sky, and takes the rest. Bandits squat in the old camp, things burrow in the dunes, and the buried city is older than anyone remembers.",
		"And something moves under the sand on the far side. Big. We don't cross there."],
	"notices": {
		"board": ["A sun-bleached board by the well, its papers pinned with cactus spines.",
			"The notice board leans in the shade, every paper curled brown at the edges.",
			"Sand drifts against a wooden board covered in pinned notices.",
			"A board on the souk wall, half its notices stuck down with date paste.",
			"Old notices flap on the board, weighted with stones against the wind.",
			"A palm-wood board, its ink faded by the sun, one fresh notice nailed on top."],
		"bounty": ["WANTED: {name}, who raids our caravans from the old camp. Gold for the deed. Report to {poster}.",
			"Dead or fled: {name}, robber of water-carriers on the dune road. Tell {poster} when it's done.",
			"{name} and crew camp on our island and take what they like. End it, then report to {poster}.",
			"BOUNTY on {name}, raider of wells and burner of tents. See {poster} to claim it.",
			"WANTED, ALIVE OR OTHERWISE: {name}. The town pays well. Report to {poster}.",
			"A captain's bounty for {name}, the sand-pirate in the camp. {poster} holds the purse. Go there after."],
		"lair": ["Something nests in {name} and the burrows grow each night. Clear them out. Report to {poster}.",
			"WORK: clear {name} before the clicking things reach the groves. Paid on report to {poster}.",
			"{name} must be emptied. Bring fire and courage. {poster} pays on your return.",
			"The caravans won't pass {name} any more. Clear it, then see {poster}.",
			"Wanted, a brave blade to clear {name}. The town's thanks, and coin from {poster} when you report.",
			"Our goats keep vanishing near {name}. Make it stop, then tell {poster}."],
		"beast": ["{name} has trampled two caravans this moon. Kill it. Report to {poster} for the reward.",
			"HUNTER WANTED: {name}, the great beast of the far sands. Report to {poster}, who pays in gold and water.",
			"Slay {name} and the far side of the island is ours again. See {poster} after.",
			"Who will face {name}? The whole town will owe you. {poster} keeps the purse. Report there.",
			"REWARD for the head of {name}, the terror under the dunes. Bring word to {poster}.",
			"{name} hunts by the sound of feet. Walk softly, strike hard, then go to {poster}."],
		"posted": ["It's done? The whole town will sleep easier tonight. Here's what was promised.",
			"I'll take the notice down myself. With pleasure. Your reward, Captain.",
			"By the wells, you actually did it! Take this, and my thanks.",
			"Ha! I knew a pirate would be good for something. Here, every coin.",
			"The caravans will move again. Bless you. Here's the purse.",
			"You came back! Most who read that notice just read it. Here."],
	},
	"service": {
		"inn": ["Rooms upstairs, camels downstairs. Try not to mix them up.", "A bed, a bath and a bowl of stew. The sand comes free.",
			"Rest here, Captain. The caravanserai's walls are thick and the tea's hot.", "Pay up front. Travellers have a way of vanishing into the dunes.",
			"Upstairs is cooler. Upstairs is also full of snoring merchants.", "Shake off your boots at the door. I sweep enough desert as it is."],
		"trade": ["Buying and selling, Captain. Mostly selling. Buying, if it shines.", "Treasure from the tombs? I don't ask where. I only ask how much.",
			"Waterskins, rope, lamp oil. Everything for the crossing.", "That trinket? Hm. Sand-scratched. I'll give you half.",
			"Fair prices! Fair for me, anyway. Ask anyone.", "Show me your loot and I'll show you my scales. Honest scales. Mostly."],
		"cook": ["Lamb with dates, slow-cooked in clay. Eat, you're too thin.", "Flatbread straight off the hot stones. Mind your fingers.",
			"Spice in everything. It keeps the food good and the cook happy.", "Couscous, saffron, a little fish. Food for a long voyage.",
			"Eat something before you go out in that heat. Doctor's orders. I'm not a doctor.", "My stew pot has walked the desert with a hundred caravans."],
	},
}
