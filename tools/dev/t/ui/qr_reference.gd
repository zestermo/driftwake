func _initialize() -> void:
	TK.seed_of(self)


func check(what: String, cond: bool) -> void:
	print(("PASS " if cond else "FAIL ") + what)
	if not cond:
		fails += 1


func _rows(qr) -> Array:
	var out := []
	for y in qr.size:
		var s := ""
		for x in qr.size:
			s += "1" if qr.modules[y * qr.size + x] else "0"
		out.append(s)
	return out


func _process(_d: float) -> bool:
	for r in REF:
		var qr = QR.encode(r[0])
		check("%s: version %d, mask %d (got %d, %d)" % [r[0], r[1], r[2], qr.version, qr.mask], qr.version == r[1] and qr.mask == r[2])
		var got := _rows(qr)
		var bad := -1
		for y in r[3].size():
			if y >= got.size() or got[y] != r[3][y]:
				bad = y
				break
		var diff := "" if bad < 0 else " (row %d: got %s want %s)" % [bad, got[bad] if bad < got.size() else "-", r[3][bad]]
		check("%s: modules match the reference%s" % [r[0], diff], bad < 0 and got.size() == r[3].size())
	var img: Image = QR.image(QR.encode(REF[1][0]), 4)
	check("image is 29 + 2x4 quiet modules", img.get_size() == Vector2i(37, 37))
	var quiet_light := true
	for i in 37:
		for p in [Vector2i(i, 0), Vector2i(i, 3), Vector2i(0, i), Vector2i(36, i)]:
			quiet_light = quiet_light and img.get_pixelv(p).r > 0.5
	check("quiet zone is light", quiet_light)
	check("finder corner is dark", img.get_pixel(4, 4).r < 0.5)
	return TK.done(fails)
